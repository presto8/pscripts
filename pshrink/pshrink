#!/usr/bin/env python

"""
pshrink by Preston Hunt <me@prestonhunt.com>
https://github.com/presto8/pythonskeletonsimple

An ffmpeg wrapper.
"""

import argparse
import fcntl
import json
import os
import subprocess
import sys
import shutil
import shlex
import time


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter, add_help=False)

    parser.add_argument('paths', nargs='+', help='paths to process')
    parser.add_argument('--crf', default=27, type=int, help='target crf (default 27) or relative -n/+n to default')
    parser.add_argument('--vertical', '-v', default=0, type=int, help='target vertical pixels')
    parser.add_argument('--p720', '--720p', default=False, action='store_true', help='same as --veritcal=720')
    parser.add_argument('--p1080', '--1080p', default=False, action='store_true', help='same as --vertical=1080')
    parser.add_argument('--opus', default=False, action='store_true', help='encode audio to opus')
    parser.add_argument('--auto', default=False, action='store_true', help='max 1080p, max audio 110 kbps (opus), drop data tracks')
    parser.add_argument('--slow', default=False, action='store_true', help='use -preset slow, 2-3x longer, 10-20% better quality/compression')
    parser.add_argument('--srt', default=False, action='store_true', help='convert subtitles to srt for mkv compatibilty')
    parser.add_argument('--mp4', default=False, action='store_true', help='use mp4 container instead of mkv')
    parser.add_argument('--drop', default=[], action='append', type=int, help="drop streams, e.g. --drop 2 --drop 3")
    parser.add_argument('--script', default=False, action='store_true', help='create script instead of running ffmpeg')
    parser.add_argument('--stereo', default=False, action='store_true', help="force stereo audio (downmix if more channels)")
    parser.add_argument('--idle', default=False, action='store_true', help='wait for 15 continuous minutes without other pshrink or ffmpeg processes before starting')

    return parser.parse_args()


def main():
    if ARGS.idle:
        wait_until_idle()

    if ARGS.p720:
        ARGS.vertical = 720

    if ARGS.p1080:
        ARGS.vertical = 1080

    if ARGS.crf < 5:
        # treat this as relative to 27 (positive or negative)
        ARGS.crf = 27 + ARGS.crf

    for path in ARGS.paths:
        if ARGS.auto:
            streaminfo = get_stream_info(path)
            streams = streaminfo.get('streams', [])
            if audio_br := get_audio_bitrate(streams):
                if audio_br > 110000:
                    ARGS.opus = True
            if wh := get_video_wh(streams):
                if wh[1] > 1080:
                    ARGS.vertical = 1080
            # Mastroka only supports video, audio, and subtitle streams.  Drop
            # any data tracks to avoid ffmpeg errors.
            for track in get_data_tracks(streams):
                ARGS.drop.append(track)

        if not already_done(path):
            shrink(path)


def other_tasks_running() -> bool:
    """Check Linux's process list, excluding this pshrink process."""
    task_names = {'pshrink', 'pshrink.parallel', 'ffmpeg'}
    own_pid = os.getpid()
    with os.scandir('/proc') as processes:
        for process in processes:
            if not process.name.isdigit() or int(process.name) == own_pid:
                continue
            try:
                with open(f'{process.path}/stat') as f:
                    stat = f.read()
                # The command name can contain spaces and parentheses.
                end = stat.rindex(')')
                name = stat[stat.index('(') + 1:end]
                if stat[end + 2:].split()[0] in {'Z', 'X'}:
                    continue
                if name in task_names:
                    return True
                with open(f'{process.path}/cmdline', 'rb') as f:
                    args = f.read().split(b'\0')
                executable = os.path.basename(os.fsdecode(args[0]))
                if executable in task_names:
                    return True
                # Python scripts usually appear as "python /path/to/pshrink".
                if executable.startswith(('python', 'pypy')):
                    for arg in args[1:]:
                        arg = os.fsdecode(arg)
                        if arg in {'-c', '-m'}:
                            break
                        if arg and not arg.startswith('-'):
                            if os.path.basename(arg) in task_names:
                                return True
                            break
            except (FileNotFoundError, ProcessLookupError, PermissionError):
                # Processes may exit while their details are being read.
                continue
    return False


def wait_until_idle():
    """Require a full quiet window observed after this invocation starts."""
    quiet_seconds = 15 * 60
    quiet_since = time.monotonic()
    print('Waiting for 15 minutes without other pshrink or ffmpeg tasks...', flush=True)
    while True:
        busy = other_tasks_running()
        now = time.monotonic()
        if busy:
            quiet_since = now
        remaining = quiet_seconds - (now - quiet_since)
        if remaining <= 0:
            print('Idle period complete; starting pshrink.', flush=True)
            return
        time.sleep(min(1, remaining))


def already_done(path):
    return path.endswith(".processed") or \
        path.startswith("0,incomplete") or \
        "pshrink" in path


def shrink(path: str):
    dirname = os.path.dirname(path) or "."
    basename = os.path.basename(path)

    opts = ["-i", path]
    slugs = []

    if ARGS.vertical:
        # ensure resolution is a multiple of 16 for optimal codec efficiency
        opts += ["-vf", f"scale=h={ARGS.vertical}:force_original_aspect_ratio=decrease:force_divisible_by=16"]
        slugs.append(f"{ARGS.vertical}p")

    opts += [
        "-map", "0",                # copy all streams by default, but allow codec changes below to override this
        "-c", "copy",               # copy streams verbatim except as overriden below
        "-c:v", "libx265",
        "-pix_fmt", "yuv420p10le",   # convert to 10-bit x265, smaller size and higher quality, less compatibility
        "-crf", f"{ARGS.crf}",       # default is 28, lower is higher quality
    ]

    for stream in ARGS.drop:
        opts += ["-map", f"-0:{stream}"]

    if ARGS.srt:
        opts += ["-c:s", "srt"]     # convert subs to srt for mkv compatibilty

    if ARGS.stereo:
        opts += ["-ac", "2"]        # downmix to stereo if more channels

    env = os.environ.copy()
    env['FFREPORT'] = f"file={dirname}/0,log,{basename}.log:level=32"

    if ARGS.crf != 27:
        slugs.append(f"crf{ARGS.crf}")

    if ARGS.opus:
        opts += ["-c:a", "libopus"]
        # opts += ["-ac", "2"]  # downmix to 2 channels maximum
        slugs.append("opus")

    slugs.append("pshrink")

    all_slugs = ".".join(slugs)
    ext = "mp4" if ARGS.mp4 else "mkv"
    output = f"{dirname}/{basename}.{all_slugs}.{ext}"
    # Use .mkv for temp file otherwise the original container format will be used
    temp = f"{dirname}/0,incomplete,{basename}.mkv"

    if ARGS.slow:
        opts += ["-preset", "slow"]

    opts += ["-metadata", f"ffmpeg_options={opts}"]
    opts += [temp]
    opts += ["-y"]  # overwrite output without asking, since we use a unique temp name based on options

    if ARGS.script:
        script_name = f"{path}.pshrink.sh"
        escaped = [shlex.quote(opt) for opt in opts]
        with open(script_name, "w") as f:
            f.write("#!/usr/bin/env bash\n\n")
            f.write("ffmpeg ")
            f.write(" ".join(escaped) + "\n")
        print(f"Script written to {script_name}")
        return

    if not run_ffmpeg(opts, env):
        print(f"ffmpeg failed for: {path}")
        return

    run_touch(path, temp)
    os.rename(temp, output)
    os.rename(path, f"{path}.processed")


def run_ffmpeg(opts, env) -> bool:
    "Returns True if ffmpeg completed successfully."
    if shutil.which("ffpb"):
        exe = ["ffpb"]
    else:
        exe = ["ffmpeg", "-hide_banner"]

    cmd = exe + opts
    print(cmd)
    result = subprocess.run(cmd, env=env)
    if result.returncode != 0:
        print(result)
    return result.returncode == 0


class StreamInfo(dict):
    pass


def get_stream_info(path) -> StreamInfo:
    cmd = "ffprobe -print_format json -show_format -show_streams".split() + [path]
    result = subprocess.run(cmd, capture_output=True)
    j = json.loads(result.stdout)
    return j


def get_audio_bitrate(streams) -> int | None:
    for stream in streams:
        if stream['codec_type'] == 'audio':
            try:
                return int(stream['bit_rate'])
            except KeyError:
                pass
    return None


def get_video_wh(streams) -> tuple[int, int] | None:
    for stream in streams:
        if stream['codec_type'] == 'video':
            return int(stream['width']), int(stream['height'])
    return None


def get_data_tracks(streams):
    for stream in streams:
        if stream['codec_type'] == 'data':
            yield stream['index']


def run_touch(reference, target):
    cmd = ["touch", "-r", reference, target]
    subprocess.run(cmd)


def run(*args):
    return subprocess.run(args, capture_output=True, text=True)


class Fail(Exception):
    pass


if __name__ == '__main__':
    try:
        # Command-line arguments are considered as immutable constants of the
        # universe, and thus are globally available in this script.
        ARGS = parse_args()
        main()
    except Fail as f:
        print(*f.args, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("Ctrl+C")
